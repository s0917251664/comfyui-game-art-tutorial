{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "templates/_schema/template.schema.json",
  "title": "gameart 固定 API graph template(template.json)",
  "description": "文件用途的結構說明。實際驗證以 tools_src/comfyui_pipeline/runner/template.py 為準(只用標準庫,不讀這份 schema);tests/test_templates.py 會確認兩邊的欄位清單一致。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "summary",
    "status",
    "min_comfyui_version",
    "requires_custom_nodes",
    "graph",
    "provenance",
    "slots",
    "pre",
    "post",
    "frame_anchoring",
    "models",
    "capability_gate",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)+$",
      "description": "等於 templates/ 底下的資料夾路徑"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "technical_pass",
        "retired"
      ],
      "description": "任何 model 缺 sha256 pin 時不能是 technical_pass"
    },
    "status_note": {
      "type": "string"
    },
    "min_comfyui_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "對應官方範本的 minComfyUIVersion。preflight 讀 /system_stats 的 comfyui_version,較低就擋下,讀不到只提醒。目前寫實測通過的版本;要放寬必須在較舊版本實測"
    },
    "requires_custom_nodes": {
      "type": "array",
      "description": "對應官方範本的 requiresCustomNodes:graph 用到的非 core 節點所屬套件。只用 core 節點時寫 []",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "description": "source=registry 時是 Comfy registry id(套件 pyproject.toml 的 project.name)"
          },
          "source": {
            "enum": [
              "registry",
              "repo"
            ],
            "description": "repo＝這個 repo 自己的 custom node(tools_src/ 底下)"
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "format",
        "sha256",
        "canonical_sha256"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "format": {
          "const": "comfyui-api"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "檔案位元組"
        },
        "canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sort_keys、緊湊分隔、ensure_ascii=False 的 JSON;和 result manifest 的 graph_sha256 同算法"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_from",
        "upstream",
        "tested_source_sha256",
        "evidence"
      ],
      "properties": {
        "derived_from": {
          "type": "string"
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "blob",
            "comfyui_version"
          ],
          "description": "對應的官方來源。kind=none 時 name、blob、comfyui_version 都是 null,並在 note 說明原因",
          "properties": {
            "kind": {
              "enum": [
                "workflow_templates",
                "core_blueprint",
                "none"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ],
              "description": "workflow_templates:範本名稱,不含 .json(例如 video_wan_vace_inpainting);core_blueprint:ComfyUI blueprints/ 裡的檔名,含 .json"
            },
            "blob": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$",
              "description": "派生時那份官方檔案的 git blob sha(git hash-object --no-filters)"
            },
            "comfyui_version": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "派生／比對時使用的 ComfyUI 版本"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "tested_source_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "note"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "相對 repo 根目錄,必須存在"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/slot"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "slot",
          "width",
          "height"
        ],
        "properties": {
          "rule": {
            "enum": [
              "points_within"
            ]
          },
          "slot": {
            "type": "string"
          },
          "width": {
            "type": "string"
          },
          "height": {
            "type": "string"
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/option"
      }
    },
    "fixed_notes": {
      "type": "string"
    },
    "pre": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "description": "送出前步驟(檢查輸入、產生工作檔、上傳);清單外的步驟一律拒絕"
    },
    "post": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "frame_anchoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first",
        "last",
        "reference_role",
        "time_alignment",
        "continuity"
      ],
      "properties": {
        "first": {
          "enum": [
            "image",
            "conditioning",
            "same_as_first",
            "none"
          ]
        },
        "last": {
          "enum": [
            "image",
            "conditioning",
            "same_as_first",
            "none"
          ]
        },
        "reference_role": {
          "enum": [
            "identity",
            "selection",
            "none"
          ]
        },
        "time_alignment": {
          "anyOf": [
            {
              "enum": [
                "source_from_frame_0",
                "per_source_frame"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "continuity": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "capability_gate": {
      "type": "object",
      "required": [
        "nodes",
        "selectors",
        "files",
        "platforms",
        "capability"
      ],
      "properties": {
        "nodes": {
          "const": "from_graph"
        },
        "selectors": {
          "const": "from_models"
        },
        "files": {
          "const": "from_models"
        },
        "platforms": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]+-[a-z0-9]+$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "technical_pass",
                  "untested",
                  "unsupported"
                ]
              },
              "evidence": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "min_memory_mb": {
          "type": [
            "integer",
            "null"
          ]
        },
        "capability": {
          "type": "string"
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "node",
          "kind",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "video",
              "image",
              "image_sequence"
            ]
          },
          "role": {
            "enum": [
              "candidate",
              "mask",
              "preview"
            ]
          },
          "expect_count": {
            "type": "integer"
          }
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "input"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "placeholder": {
          "type": "string",
          "pattern": "^__[A-Z0-9_]+__$"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "targets"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "string",
            "int",
            "float",
            "bool",
            "seed",
            "points",
            "image",
            "video",
            "mask_image",
            "path",
            "output_prefix"
          ],
          "description": "path 是本機檔案或資料夾(例如遮罩 PNG 資料夾或 layers.zip),只給 pre／post 步驟讀,不上傳、不寫進 graph。image／video／mask_image 有 upload 時上傳到 ComfyUI;沒有 upload 時也是本機輸入"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "description": "一般必須至少一個;本機輸入(path、沒有 upload 的檔案)一定是 [];int／float／string／text／bool 寫 [] 時只給步驟用,必須被某個 pre／post 步驟引用"
        },
        "default": {},
        "default_from": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "upload": {
          "type": "boolean",
          "description": "只能用在 image／video／mask_image;true 時必須剛好出現在一個 upload 步驟"
        },
        "generated": {
          "type": "boolean",
          "description": "PR 3.3:上傳檔由 pre 步驟產生(例如 vace_work_area 的 control／mask),使用者不能指定;產生它的步驟要排在 upload 步驟之前"
        },
        "from_pre": {
          "type": "string",
          "pattern": "^\\{pre\\.[a-z0-9_]+\\.[a-z0-9_]+\\}$",
          "description": "PR 3.3:值來自 pre 步驟的結果,例如 {pre.vace_work_area.width}。dry-run／preflight 時 graph 顯示 <pre:步驟.欄位>;graph 目標可以是占位"
        },
        "validate": {
          "type": "object"
        },
        "tested_values": {
          "type": "array"
        },
        "help": {
          "type": "string"
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "default",
        "when_true"
      ],
      "properties": {
        "default": {
          "type": "boolean"
        },
        "help": {
          "type": "string"
        },
        "when_true": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "op",
              "node",
              "input"
            ],
            "properties": {
              "op": {
                "enum": [
                  "set_link",
                  "set_value"
                ]
              },
              "node": {
                "type": "string"
              },
              "input": {
                "type": "string"
              },
              "from": {
                "type": "array"
              },
              "value": {}
            }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "step"
      ],
      "properties": {
        "step": {
          "type": "string"
        }
      },
      "description": "可用步驟與參數以 tools_src/comfyui_pipeline/runner/steps.py 的 STEPS 為準。PR 3.3 新增 vace_work_area(pre)、paste_back、qa_outside_mask_unchanged(post)"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "node",
        "input",
        "filename",
        "path",
        "directory",
        "size_bytes",
        "sha256",
        "source",
        "url"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "directory": {
          "type": [
            "string",
            "null"
          ],
          "description": "對應官方 properties.models[].directory。path 在 models/ 底下時必須是 models/<directory>/<filename>;不在 models/ 底下(custom node 自己的 ckpts)時寫 null"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "repo",
            "revision",
            "file"
          ],
          "properties": {
            "repo": {
              "type": "string"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "file": {
              "type": "string"
            }
          },
          "description": "Hugging Face repo、固定 commit 與檔案路徑"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "description": "對應官方 properties.models[].url,必須等於 https://huggingface.co/<repo>/resolve/<revision>/<file>;沒有 source 時是 null"
        },
        "notes": {
          "type": "string"
        },
        "pin_status": {
          "type": "string",
          "description": "sha256 為 null 時必填"
        },
        "auto_download": {
          "type": "boolean",
          "description": "節點缺檔會自動下載；preflight 缺檔一定擋下"
        }
      }
    }
  }
}

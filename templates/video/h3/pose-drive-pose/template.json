      "help": "寫進 graph 的 prompt。generate.py 在沒有 <Picture 或 <Video 時會先補前綴；這份 template 不改寫，slot 要填最終進 graph 的文字。"
    },
    "width": {
      "type": "int",
      "default": 768,
      "validate": {
        "min": 8,
        "multiple_of": 8
      },
      "targets": [
        {
          "node": "104",
          "input": "width"
        }
      ],
      "help": "輸出寬。預設是這份 template 的代表值"
    },
    "height": {
      "type": "int",
      "default": 768,
      "validate": {
        "min": 8,
        "multiple_of": 8
      },
      "targets": [
        {
          "node": "104",
          "input": "height"
        }
      ],
      "help": "輸出高。預設是這份 template 的代表值"
    },
    "length": {
      "type": "int",
      "default": 56,
      "validate": {
        "min": 1,
        "max": 10000
      },
      "targets": [
        {
          "node": "104",
          "input": "length"
        }
      ],
      "help": "影格數。預設是 duration 2 秒時的長度；案例要改長度時直接設這個 slot"
    },
    "seed": {
      "type": "seed",
      "default": "auto",
      "targets": [
        {
          "node": "15",
          "input": "noise_seed"
        }
      ],
      "help": "亂數種子。auto 由 runner 產生；graph 裡的 -1 會被換掉"
    },
    "filename_prefix": {
      "type": "string",
      "default": "pose_drive",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "max_length": 96
      },
      "targets": [
        {
          "node": "92",
          "input": "filename_prefix"
        }
      ],
      "help": "SaveVideo 的 filename_prefix。預設是固定前綴，不是 output_prefix"
    }
  },
  "pre": [
    {
      "step": "check_image",
      "slot": "start_image"
    },
    {
      "step": "check_video",
      "slot": "motion_video",
      "fps": 24,
      "cfr": true
    },
    {
      "step": "upload",
      "slots": [
        "start_image",
        "motion_video"
      ]
    }
  ],
  "post": [
    {
      "step": "check_video_output",
      "output": "video",

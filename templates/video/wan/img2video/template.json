    "filename_prefix": {
      "type": "string",
      "default": "img2video",
      "validate": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "max_length": 96
      },
      "targets": [
        {
          "node": "58",
          "input": "filename_prefix"
        }
      ],
      "help": "SaveVideo 的 filename_prefix。預設是固定前綴，不是 output_prefix"
    }
